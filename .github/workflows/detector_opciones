on:
  schedule:
    # Una vez por hora, offset de minuto (no ":00" exacto) por el mismo
    # motivo que el bot diario -- esquivar la congestión de cron
    # documentada en GitHub. Ventana 14:13-20:13 UTC = 11:13-17:13 ART,
    # cubre la rueda completa (11:00-17:00 ART) con margen.
    - cron: "13 14-20 * * 1-5"
  workflow_dispatch:
    inputs:
      script:
        description: "senales, iv, o ambos (fuerza ese script sin importar la hora)"
        required: true
        default: "ambos"
jobs:
  correr_detector:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Descargar el repo
        uses: actions/checkout@v4
      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Instalar dependencias
        run: |
          pip install --upgrade pip
          pip install yfinance ta pandas numpy requests gspread google-auth
      - name: Chequeo de señales direccionales
        if: ${{ github.event_name != 'workflow_dispatch' || inputs.script == 'senales' || inputs.script == 'ambos' }}
        env:
          GOOGLE_SHEETS_ID_OPCIONES: ${{ secrets.GOOGLE_SHEETS_ID_OPCIONES }}
          GOOGLE_SHEETS_CREDENTIALS_JSON: ${{ secrets.GOOGLE_SHEETS_CREDENTIALS_JSON }}
        run: python chequeo_senales_opciones.py
      - name: Registro de IV / VRP / IV Rank
        if: ${{ github.event_name != 'workflow_dispatch' || inputs.script == 'iv' || inputs.script == 'ambos' }}
        env:
          GOOGLE_SHEETS_ID_OPCIONES: ${{ secrets.GOOGLE_SHEETS_ID_OPCIONES }}
          GOOGLE_SHEETS_CREDENTIALS_JSON: ${{ secrets.GOOGLE_SHEETS_CREDENTIALS_JSON }}
          IOL_USUARIO: ${{ secrets.IOL_USUARIO }}
          IOL_PASSWORD: ${{ secrets.IOL_PASSWORD }}
        run: python historial_iv_ggal.py
# NOTA: los dos scripts corren en el MISMO job, uno después del otro --
# comparten runner y no necesitan coordinarse entre sí (a diferencia
# del bot diario, acá no hay lock ni estado de posiciones que proteger,
# solo lectura/escritura de filas nuevas en Sheets). El chequeo de
# señales solo necesita las credenciales de Sheets (usa yfinance para
# el precio, no la API de IOL); el registro de IV sí necesita login a
# IOL además.
